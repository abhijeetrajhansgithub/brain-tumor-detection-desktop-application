def __CLASSIFY_IMAGE_btcm_mdl_v01(h5_MODEL_path, keras_MODEL_path, image_path, img_size=150):
    """
    Classify an image using both h5 and keras models, and check if the results are the same.

    Args:
        h5_MODEL_path (str): Path to the h5 model.
        keras_MODEL_path (str): Path to the keras model.
        image_path (str): Path to the image to be classified.
        img_size (int, optional): Size to which the image is resized. Defaults to 150.

    Returns:
        tuple: Predicted class and its label if the predictions are the same, else (-1, ("Error", -1)).
    """
    import warnings
    warnings.filterwarnings("ignore")

    import cv2
    import numpy as np
    from tensorflow.keras.models import load_model

    label_mapping = {
        0: ('no_tumor', 0),
        1: ('glioma_tumor', 1),
        2: ('meningioma_tumor', 2),
        3: ('pituitary_tumor', 3)
    }
    print("2. Image path: ", image_path)

    IMAGE = cv2.imread(image_path)
    print("3. Image: ", IMAGE)

    img_resized = cv2.resize(IMAGE, (img_size, img_size)).astype(np.float32) / 255.0
    img_resized = np.expand_dims(img_resized, axis=0)

    # Load h5 model
    _h5_model = load_model(h5_MODEL_path)

    # Load keras model
    _keras_model = load_model(keras_MODEL_path)

    # Predict using the keras model
    predictions_keras = _keras_model.predict(img_resized)
    predictions_h5 = _h5_model.predict(img_resized)

    predictions = None
    if np.argmax(predictions_h5) == np.argmax(predictions_keras):
        predictions = predictions_keras
    else:
        return -1, ("Error", -1)

    predicted_class = np.argmax(predictions)
    confidence_score = np.max(predictions)
    print(f"Image: {image_path}")
    print(f"Prediction: {predictions}")
    print(f"Confidence Score: {confidence_score:.2f}")
    print(f"Predicted Class: {predicted_class} ({label_mapping[predicted_class]})\n")

    return predicted_class, label_mapping[predicted_class], float(confidence_score)

